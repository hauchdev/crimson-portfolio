---
import { site } from "../data/site";
---

<div class="grid gap-2 md:grid-cols-3">
  {
    site.repositories.map((repo) => (
      <a
        href={repo.href}
        target="_blank"
        rel="noreferrer"
        class="reveal panel group rounded-lg p-5 transition hover:-translate-y-0.5 hover:border-white/15"
      >
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs font-semibold text-neutral-200">{repo.name}</span>
          <span class="font-mono text-[8px] text-neutral-700">↗</span>
        </div>

        <p class="mt-3 min-h-10 text-[11px] leading-5 text-neutral-600">{repo.description}</p>

        <div class="mt-5 flex items-center gap-4 font-mono text-[8px] uppercase tracking-widest text-neutral-700">
          <span>{repo.language}</span>
          <span>★ {repo.stars}</span>
          <span>⑂ {repo.forks}</span>
        </div>
      </a>
    ))
  }
</div>
