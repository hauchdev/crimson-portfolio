---
import { site } from "../data/site";
---

<div class="relative">
  <div class="absolute bottom-0 left-[52px] top-0 hidden w-px bg-white/7 md:block"></div>

  <div class="space-y-3">
    {
      site.timeline.map((item, index) => (
        <article class="reveal grid gap-4 md:grid-cols-[104px_1fr]">
          <div class="font-mono text-[10px] text-red-500">
            <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-red-500 align-middle"></span>
            {item.year}
          </div>

          <div class="panel rounded-lg p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h3 class="text-sm font-bold text-white">{item.role}</h3>
                {item.company && <p class="mt-1 font-mono text-[9px] uppercase tracking-widest text-neutral-700">{item.company}</p>}
              </div>
              <div class="flex flex-wrap gap-1.5">
                {item.tags.map((tag) => <span class="font-mono text-[8px] text-neutral-600">#{tag}</span>)}
              </div>
            </div>
            <p class="mt-4 max-w-3xl text-xs leading-6 text-neutral-600">{item.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</div>
