---
import { site } from "../data/site";
---

<div class="grid grid-cols-2 gap-2 md:grid-cols-4">
  {
    site.stats.map((stat) => (
      <article class="reveal panel rounded-lg p-4">
        <div class="text-2xl font-extrabold tracking-[-.05em] text-white">{stat.value}</div>
        <div class="mt-2 font-mono text-[8px] uppercase tracking-[.13em] text-neutral-600">{stat.label}</div>
      </article>
    ))
  }
</div>
