---
import { site } from "../data/site";
---

<div class="grid gap-2 md:grid-cols-2">
  {
    site.buildHighlights.map((item, index) => (
      <article class="reveal panel rounded-lg p-5 transition hover:border-white/15">
        <div class="mb-6 flex items-center justify-between">
          <span class="font-mono text-[9px] text-red-500">0{index + 1}</span>
          <span class="font-mono text-[8px] uppercase tracking-widest text-neutral-700">{item.meta}</span>
        </div>
        <h3 class="text-base font-bold text-neutral-100">{item.title}</h3>
        <p class="mt-2 text-xs leading-6 text-neutral-600">{item.description}</p>
      </article>
    ))
  }
</div>
