---
import { site } from "../data/site";
---

<header class="fixed inset-x-0 top-0 z-50 px-3 pt-3">
  <nav
    class="container-main panel flex h-12 items-center justify-between rounded-lg px-3 backdrop-blur-xl"
    aria-label="Main navigation"
  >
    <a href="/" class="font-mono text-sm font-bold tracking-tight">
      <span class="text-red-500">H</span>{site.shortName.slice(1)}
    </a>

    <div class="hidden items-center gap-5 md:flex">
      {
        site.navItems.map((item) => (
          <a
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
            class="font-mono text-[10px] uppercase tracking-[.12em] text-neutral-500 transition hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <a
      href={site.hero.primaryCta.href}
      class="rounded-md border border-red-500/40 bg-red-500/10 px-3 py-2 font-mono text-[10px] font-semibold uppercase tracking-widest text-red-400 transition hover:bg-red-500 hover:text-white"
    >
      Contact
    </a>
  </nav>
</header>
